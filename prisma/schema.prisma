datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/prisma-generated"
}

model News {
  id          Int      @id @default(autoincrement())
  name        String?
  author      String?
  title       String
  description String?  @db.Text
  url         String   @unique
  urlToImage  String?  @db.Text
  publishedAt String?
  content     String?  @db.Text
}
